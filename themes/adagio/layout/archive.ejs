<!DOCTYPE html>
<html lang="zh-cmn-Hans">
<%- partial('_partial/head') %>

<%
  // 1. 动态获取当前页面的年份（如果 page.year 存在），否则默认为 2026
  let targetYear = page.year ? parseInt(page.year) : 2026;
  
  // 2. 使用更稳健的筛选方式，确保转换日期为数值年份
  let count = site.posts.filter(function(post) {
    return parseInt(post.date.format('YYYY')) === targetYear;
  }).length;
%>

<body>
    <%- partial('_partial/nav', {index: false}) %>
    <div class="jumbotron jumbotron-fluid">
        <div class="container">
            <h1 class="mt-4 article-title page-title">ARCHIVE(<%- count %>): <%- page.year %></h1>
        </div>
    </div>

    <div class="container">
        

        <div class="row mt-3">
            <div class="col-md-9">
                <% page.posts.each(function(post) { %>
                <div class="row">
                    <div class="col">
                        <a href="<%- url_for(post.path) %>" class="index-card-link">
                            <div class="card-body index-card-box">
                                <h4 class="card-title text-dark article-title"><%- post.title %></h4>
                                <h6 class="card-subtitle mt-2 text-muted">
                                    By <% if (post.author) { %><%- post.author %><% } else { %>XyGod<% } %>
                                    ; Published on <%- post.date.format('YYYY-MM-DD') %></h6>
                            </div>
                        </a>
                    </div>
                </div>
                <hr class="row">
                <% }) %>
                <div class="paginator">
                    <%- partial('_partial/paginator', {index: true}) %>
                </div>
            </div>
            <div class="col-md-3 mt-3">
                <%- partial('_partial/sidebar') %>
            </div>
        </div>
    </div>
    <%- partial('_partial/footer') %>
    <%- partial('_partial/script') %>
</body>

</html>