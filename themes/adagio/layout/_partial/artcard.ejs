<div class="row  flex-column">
    <div class="col">
        <a href="<%- url_for(post.path) %>" class="index-card-link">
            <div class="card-body index-card-box">
                <h4 class="card-title text-dark article-title"><%- post.title %></h4>
                <h6 class="card-subtitle mt-2 text-muted">
                    作者: <% if (post.author) { %><%- post.author %><% } else { %>
                    XyGod<% } %>;
                    发布于 <%- post.date.format('YYYY-MM-DD') %>
                     
                </h6>
                <p class="card-text text-dark mt-2 article-text">
                    <% if (post.content.indexOf('<a id="more">') > -1) { let start = post.content.indexOf('<a id="more">'); %><%- strip_html(post.content.slice(0, start)) %><% } else { %><%- truncate(strip_html(post.content), {length:100}) %><% } %>
                </p>
            </div>
        </a>
    </div>
     <% if (post.tags) { %>
            <div class="tags text-right mr-4">
                <ul class="tag-list">
                    <% post.tags.forEach(function(tag) { %>
                        <li class="tag-list-item">
                            <a class="tag-list-link"
                                href="<%- url_for('/tags/'+tag.name+'/') %>"><%- tag.name %></a>
                        </li>
                        <% }) %>
                </ul>
            </div>
        <% } %>
</div>